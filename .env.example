# Example environment variables for EZBI Analytics
# Copy this file to .env and fill in your actual values

# GitHub
GITHUB_TOKEN=your_github_token_here
GITHUB_REPO=your_username/your_repo

# Vercel
VERCEL_TOKEN=your_vercel_token_here
VERCEL_PROJECT_ID=your_project_id_here
VERCEL_TEAM_ID=your_team_id_here

# Railway
RAILWAY_TOKEN=your_railway_token_here
RAILWAY_PROJECT_ID=your_project_id_here

# Database
DATABASE_URL=postgresql://user:pass@host:5432/ezbi
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_MASTER_KEY=your_encryption_key_here

# External APIs
OPENAI_API_KEY=your_openai_api_key_here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Monitoring
DATADOG_API_KEY=your_datadog_key_here
SENTRY_DSN=https://your_sentry_dsn_here

# Atlassian
JIRA_API_KEY=your_jira_api_key_here
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your_email@domain.com

# Confluence  
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=your_email@domain.com

# Supabase
ProjectURL=https://your-project.supabase.co
SUPABASE_API_KEY=your_supabase_api_key_here