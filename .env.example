# 🔑 EZBI Analytics - Variables d'Environnement

# =====================================
# GitHub Configuration
# =====================================
# Personal Access Token avec permissions: repo, workflow, admin:org, user
# Créer sur: https://github.com/settings/tokens
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =====================================
# Database Configuration  
# =====================================
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/ezbi_analytics

# =====================================
# Claude Flow Configuration
# =====================================
CLAUDE_FLOW_HOOKS_ENABLED=true
CLAUDE_FLOW_TELEMETRY_ENABLED=true
CLAUDE_FLOW_GITHUB_INTEGRATION=true

# =====================================
# Deployment Tokens (optionnel)
# =====================================
# Railway CLI déjà connecté
# RAILWAY_TOKEN=xxxxxxxx

# Vercel CLI déjà connecté  
# VERCEL_TOKEN=xxxxxxxx

# =====================================
# Security & Encryption
# =====================================
JWT_SECRET=your-super-secret-jwt-key-here
ENCRYPTION_MASTER_KEY=your-encryption-master-key-here

# =====================================
# External APIs (optionnel)
# =====================================
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# =====================================
# Monitoring (optionnel)
# =====================================
DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx