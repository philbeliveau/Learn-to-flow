# EZBI Analytics Production Environment Configuration\n\n# Application Settings\nENVIRONMENT=production\nDEBUG=false\nLOG_LEVEL=INFO\nSECRET_KEY=your-production-secret-key-here\n\n# Database Configuration\nDATABASE_HOST=postgres-service\nDATABASE_PORT=5432\nDATABASE_NAME=ezbi_analytics\nDATABASE_USER=ezbi_user\nPOSTGRES_PASSWORD=your-secure-postgres-password\nDATABASE_URL=postgresql://ezbi_user:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}\n\n# Redis Configuration\nREDIS_HOST=redis-service\nREDIS_PORT=6379\nREDIS_DB=0\nREDIS_PASSWORD=your-secure-redis-password\nREDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}\n\n# CORS Configuration\nCORS_ORIGINS=https://ezbi.example.com,https://www.ezbi.example.com,https://api.ezbi.example.com,https://ml.ezbi.example.com\n\n# API Configuration\nAPI_V1_STR=/api/v1\nPROJECT_NAME=EZBI Analytics\nPROJECT_VERSION=1.0.0\nOPENAPI_URL=/api/v1/openapi.json\nDOCS_URL=/docs\nREDOC_URL=/redoc\n\n# Security Configuration\nACCESS_TOKEN_EXPIRE_MINUTES=30\nREFRESH_TOKEN_EXPIRE_MINUTES=60\nPASSWORD_RESET_TOKEN_EXPIRE_HOURS=48\nEMAIL_RESET_TOKEN_EXPIRE_HOURS=48\nALGORITHM=HS256\n\n# Email Configuration (French hosting)\nSMTP_TLS=true\nSMTP_PORT=587\nSMTP_HOST=smtp.example.fr\nSMTP_USER=noreply@ezbi.example.com\nSMTP_PASSWORD=your-smtp-password\nEMAILS_FROM_EMAIL=noreply@ezbi.example.com\nEMAILS_FROM_NAME=EZBI Analytics\n\n# File Upload Configuration\nMAX_FILE_SIZE=50MB\nUPLOAD_FOLDER=/app/uploads\nALLOWED_EXTENSIONS=.pdf,.xlsx,.xls,.csv,.json,.xml\n\n# ML Engine Configuration\nML_MODEL_PATH=/app/models\nML_INFERENCE_HOST=0.0.0.0\nML_INFERENCE_PORT=8001\nML_CACHE_TTL=3600\nML_BATCH_SIZE=32\nML_MAX_PREDICTIONS_PER_MINUTE=1000\n\n# Monitoring Configuration\nPROMETHEUS_HOST=prometheus-service\nPROMETHEUS_PORT=9090\nGRAFANA_HOST=grafana-service\nGRAFANA_PORT=3000\nMETRICS_ENABLED=true\nMETRICS_PORT=8080\n\n# Logging Configuration\nLOG_FORMAT=json\nLOG_FILE=/app/logs/app.log\nLOG_ROTATION=daily\nLOG_RETENTION_DAYS=30\n\n# Celery Configuration\nCELERY_BROKER_URL=${REDIS_URL}\nCELERY_RESULT_BACKEND=${REDIS_URL}\nCELERY_TASK_SERIALIZER=json\nCELERY_ACCEPT_CONTENT=json\nCELERY_RESULT_SERIALIZER=json\nCELERY_TIMEZONE=Europe/Paris\n\n# Rate Limiting\nRATE_LIMIT_PER_MINUTE=100\nRATE_LIMIT_BURST=200\n\n# French Compliance\nTIMEZONE=Europe/Paris\nLOCALE=fr_FR\nDATA_RETENTION_DAYS=2555  # 7 years for French accounting\nGDPR_COMPLIANCE=true\n\n# Backup Configuration\nBACKUP_ENABLED=true\nBACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM\nBACKUP_RETENTION_DAYS=90\nBACKUP_S3_BUCKET=ezbi-backups-prod\nBACKUP_S3_REGION=eu-west-3  # Paris region\n\n# SSL/TLS Configuration\nSSL_ENABLED=true\nSSL_CERT_PATH=/etc/ssl/certs/ezbi.crt\nSSL_KEY_PATH=/etc/ssl/private/ezbi.key\nSSL_PROTOCOLS=TLSv1.2,TLSv1.3\n\n# Integration Configuration\nJIRA_ENABLED=true\nJIRA_URL=https://your-company.atlassian.net\nJIRA_USERNAME=your-jira-username\nJIRA_API_TOKEN=your-jira-api-token\n\nSAGE_ENABLED=true\nSAGE_API_URL=https://api.sage.com\nSAGE_API_KEY=your-sage-api-key\n\nEBP_ENABLED=true\nEBP_API_URL=https://api.ebp.com\nEBP_API_KEY=your-ebp-api-key\n\n# Banking Integration (French banks)\nBNP_ENABLED=true\nBNP_API_URL=https://api.bnpparibas.com\nBNP_CLIENT_ID=your-bnp-client-id\nBNP_CLIENT_SECRET=your-bnp-client-secret\n\nCREDIT_AGRICOLE_ENABLED=true\nCREDIT_AGRICOLE_API_URL=https://api.credit-agricole.com\nCREDIT_AGRICOLE_CLIENT_ID=your-ca-client-id\nCREDIT_AGRICOLE_CLIENT_SECRET=your-ca-client-secret\n\n# Performance Configuration\nWORKERS=4\nWORKER_CONNECTIONS=1000\nWORKER_CLASS=uvicorn.workers.UvicornWorker\nKEEP_ALIVE=2\nMAX_REQUESTS=1000\nMAX_REQUESTS_JITTER=50\nPRELOAD_APP=true\n\n# Health Check Configuration\nHEALTH_CHECK_ENABLED=true\nHEALTH_CHECK_PATH=/health\nHEALTH_CHECK_TIMEOUT=30\n\n# Feature Flags\nFEATURE_USER_REGISTRATION=true\nFEATURE_EMAIL_VERIFICATION=true\nFEATURE_PASSWORD_RESET=true\nFEATURE_MULTI_COMPANY=true\nFEATURE_ADVANCED_ANALYTICS=true\nFEATURE_AUDIT_LOG=true\nFEATURE_NOTIFICATIONS=true\nFEATURE_INTEGRATIONS=true\nFEATURE_ML_PREDICTIONS=true\nFEATURE_REAL_TIME_UPDATES=true"