# EZBI Analytics Staging Environment Configuration\n\n# Application Settings\nENVIRONMENT=staging\nDEBUG=false\nLOG_LEVEL=DEBUG\nSECRET_KEY=staging-secret-key-change-in-production\n\n# Database Configuration\nDATABASE_HOST=postgres-service\nDATABASE_PORT=5432\nDATABASE_NAME=ezbi_analytics_staging\nDATABASE_USER=ezbi_user\nPOSTGRES_PASSWORD=staging-postgres-password\nDATABASE_URL=postgresql://ezbi_user:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}\n\n# Redis Configuration\nREDIS_HOST=redis-service\nREDIS_PORT=6379\nREDIS_DB=0\nREDIS_PASSWORD=staging-redis-password\nREDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}\n\n# CORS Configuration\nCORS_ORIGINS=https://staging.ezbi.example.com,https://staging-api.ezbi.example.com,https://staging-ml.ezbi.example.com,http://localhost:3000\n\n# API Configuration\nAPI_V1_STR=/api/v1\nPROJECT_NAME=EZBI Analytics (Staging)\nPROJECT_VERSION=1.0.0-staging\nOPENAPI_URL=/api/v1/openapi.json\nDOCS_URL=/docs\nREDOC_URL=/redoc\n\n# Security Configuration\nACCESS_TOKEN_EXPIRE_MINUTES=60\nREFRESH_TOKEN_EXPIRE_MINUTES=120\nPASSWORD_RESET_TOKEN_EXPIRE_HOURS=48\nEMAIL_RESET_TOKEN_EXPIRE_HOURS=48\nALGORITHM=HS256\n\n# Email Configuration (Test)\nSMTP_TLS=true\nSMTP_PORT=587\nSMTP_HOST=smtp.mailtrap.io\nSMTP_USER=your-mailtrap-user\nSMTP_PASSWORD=your-mailtrap-password\nEMAILS_FROM_EMAIL=noreply@staging.ezbi.example.com\nEMAILS_FROM_NAME=EZBI Analytics (Staging)\n\n# File Upload Configuration\nMAX_FILE_SIZE=50MB\nUPLOAD_FOLDER=/app/uploads\nALLOWED_EXTENSIONS=.pdf,.xlsx,.xls,.csv,.json,.xml\n\n# ML Engine Configuration\nML_MODEL_PATH=/app/models\nML_INFERENCE_HOST=0.0.0.0\nML_INFERENCE_PORT=8001\nML_CACHE_TTL=1800\nML_BATCH_SIZE=16\nML_MAX_PREDICTIONS_PER_MINUTE=500\n\n# Monitoring Configuration\nPROMETHEUS_HOST=prometheus-service\nPROMETHEUS_PORT=9090\nGRAFANA_HOST=grafana-service\nGRAFANA_PORT=3000\nMETRICS_ENABLED=true\nMETRICS_PORT=8080\n\n# Logging Configuration\nLOG_FORMAT=json\nLOG_FILE=/app/logs/app.log\nLOG_ROTATION=daily\nLOG_RETENTION_DAYS=7\n\n# Celery Configuration\nCELERY_BROKER_URL=${REDIS_URL}\nCELERY_RESULT_BACKEND=${REDIS_URL}\nCELERY_TASK_SERIALIZER=json\nCELERY_ACCEPT_CONTENT=json\nCELERY_RESULT_SERIALIZER=json\nCELERY_TIMEZONE=Europe/Paris\n\n# Rate Limiting\nRATE_LIMIT_PER_MINUTE=200\nRATE_LIMIT_BURST=400\n\n# French Compliance\nTIMEZONE=Europe/Paris\nLOCALE=fr_FR\nDATA_RETENTION_DAYS=90\nGDPR_COMPLIANCE=true\n\n# Backup Configuration\nBACKUP_ENABLED=false\nBACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM\nBACKUP_RETENTION_DAYS=30\nBACKUP_S3_BUCKET=ezbi-backups-staging\nBACKUP_S3_REGION=eu-west-3\n\n# SSL/TLS Configuration\nSSL_ENABLED=true\nSSL_CERT_PATH=/etc/ssl/certs/staging.ezbi.crt\nSSL_KEY_PATH=/etc/ssl/private/staging.ezbi.key\nSSL_PROTOCOLS=TLSv1.2,TLSv1.3\n\n# Integration Configuration (Test)\nJIRA_ENABLED=false\nJIRA_URL=https://staging-company.atlassian.net\nJIRA_USERNAME=staging-jira-username\nJIRA_API_TOKEN=staging-jira-api-token\n\nSAGE_ENABLED=false\nSAGE_API_URL=https://sandbox-api.sage.com\nSAGE_API_KEY=staging-sage-api-key\n\nEBP_ENABLED=false\nEBP_API_URL=https://sandbox-api.ebp.com\nEBP_API_KEY=staging-ebp-api-key\n\n# Banking Integration (Sandbox)\nBNP_ENABLED=false\nBNP_API_URL=https://sandbox-api.bnpparibas.com\nBNP_CLIENT_ID=staging-bnp-client-id\nBNP_CLIENT_SECRET=staging-bnp-client-secret\n\nCREDIT_AGRICOLE_ENABLED=false\nCREDIT_AGRICOLE_API_URL=https://sandbox-api.credit-agricole.com\nCREDIT_AGRICOLE_CLIENT_ID=staging-ca-client-id\nCREDIT_AGRICOLE_CLIENT_SECRET=staging-ca-client-secret\n\n# Performance Configuration\nWORKERS=2\nWORKER_CONNECTIONS=500\nWORKER_CLASS=uvicorn.workers.UvicornWorker\nKEEP_ALIVE=2\nMAX_REQUESTS=500\nMAX_REQUESTS_JITTER=25\nPRELOAD_APP=false\n\n# Health Check Configuration\nHEALTH_CHECK_ENABLED=true\nHEALTH_CHECK_PATH=/health\nHEALTH_CHECK_TIMEOUT=30\n\n# Feature Flags\nFEATURE_USER_REGISTRATION=true\nFEATURE_EMAIL_VERIFICATION=true\nFEATURE_PASSWORD_RESET=true\nFEATURE_MULTI_COMPANY=true\nFEATURE_ADVANCED_ANALYTICS=true\nFEATURE_AUDIT_LOG=true\nFEATURE_NOTIFICATIONS=true\nFEATURE_INTEGRATIONS=false\nFEATURE_ML_PREDICTIONS=true\nFEATURE_REAL_TIME_UPDATES=true\n\n# Testing Configuration\nTEST_MODE=true\nTEST_DATA_ENABLED=true\nTEST_EMAIL_BACKEND=console\nTEST_PAYMENT_GATEWAY=false"