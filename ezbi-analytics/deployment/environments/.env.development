# EZBI Analytics Development Environment Configuration\n\n# Application Settings\nENVIRONMENT=development\nDEBUG=true\nLOG_LEVEL=DEBUG\nSECRET_KEY=development-secret-key-not-for-production\n\n# Database Configuration\nDATABASE_HOST=localhost\nDATABASE_PORT=5432\nDATABASE_NAME=ezbi_analytics_dev\nDATABASE_USER=ezbi_user\nPOSTGRES_PASSWORD=dev_password\nDATABASE_URL=postgresql://ezbi_user:${POSTGRES_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}\n\n# Redis Configuration\nREDIS_HOST=localhost\nREDIS_PORT=6379\nREDIS_DB=0\nREDIS_PASSWORD=dev_redis_password\nREDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}\n\n# CORS Configuration\nCORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001\n\n# API Configuration\nAPI_V1_STR=/api/v1\nPROJECT_NAME=EZBI Analytics (Development)\nPROJECT_VERSION=1.0.0-dev\nOPENAPI_URL=/api/v1/openapi.json\nDOCS_URL=/docs\nREDOC_URL=/redoc\n\n# Security Configuration\nACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24 hours for development\nREFRESH_TOKEN_EXPIRE_MINUTES=2880  # 48 hours for development\nPASSWORD_RESET_TOKEN_EXPIRE_HOURS=48\nEMAIL_RESET_TOKEN_EXPIRE_HOURS=48\nALGORITHM=HS256\n\n# Email Configuration (Development)\nSMTP_TLS=false\nSMTP_PORT=1025\nSMTP_HOST=localhost\nSMTP_USER=\nSMTP_PASSWORD=\nEMAILS_FROM_EMAIL=noreply@localhost\nEMAILS_FROM_NAME=EZBI Analytics (Dev)\n\n# File Upload Configuration\nMAX_FILE_SIZE=50MB\nUPLOAD_FOLDER=./uploads\nALLOWED_EXTENSIONS=.pdf,.xlsx,.xls,.csv,.json,.xml\n\n# ML Engine Configuration\nML_MODEL_PATH=./models\nML_INFERENCE_HOST=0.0.0.0\nML_INFERENCE_PORT=8001\nML_CACHE_TTL=300\nML_BATCH_SIZE=8\nML_MAX_PREDICTIONS_PER_MINUTE=100\n\n# Monitoring Configuration\nPROMETHEUS_HOST=localhost\nPROMETHEUS_PORT=9090\nGRAFANA_HOST=localhost\nGRAFANA_PORT=3001\nMETRICS_ENABLED=true\nMETRICS_PORT=8080\n\n# Logging Configuration\nLOG_FORMAT=console\nLOG_FILE=./logs/app.log\nLOG_ROTATION=daily\nLOG_RETENTION_DAYS=3\n\n# Celery Configuration\nCELERY_BROKER_URL=${REDIS_URL}\nCELERY_RESULT_BACKEND=${REDIS_URL}\nCELERY_TASK_SERIALIZER=json\nCELERY_ACCEPT_CONTENT=json\nCELERY_RESULT_SERIALIZER=json\nCELERY_TIMEZONE=Europe/Paris\n\n# Rate Limiting\nRATE_LIMIT_PER_MINUTE=1000\nRATE_LIMIT_BURST=2000\n\n# French Compliance\nTIMEZONE=Europe/Paris\nLOCALE=fr_FR\nDATA_RETENTION_DAYS=30\nGDPR_COMPLIANCE=true\n\n# Backup Configuration\nBACKUP_ENABLED=false\nBACKUP_SCHEDULE=0 4 * * *\nBACKUP_RETENTION_DAYS=7\nBACKUP_S3_BUCKET=ezbi-backups-dev\nBACKUP_S3_REGION=eu-west-3\n\n# SSL/TLS Configuration\nSSL_ENABLED=false\nSSL_CERT_PATH=\nSSL_KEY_PATH=\nSSL_PROTOCOLS=TLSv1.2,TLSv1.3\n\n# Integration Configuration (Development)\nJIRA_ENABLED=false\nJIRA_URL=\nJIRA_USERNAME=\nJIRA_API_TOKEN=\n\nSAGE_ENABLED=false\nSAGE_API_URL=\nSAGE_API_KEY=\n\nEBP_ENABLED=false\nEBP_API_URL=\nEBP_API_KEY=\n\n# Banking Integration (Development)\nBNP_ENABLED=false\nBNP_API_URL=\nBNP_CLIENT_ID=\nBNP_CLIENT_SECRET=\n\nCREDIT_AGRICOLE_ENABLED=false\nCREDIT_AGRICOLE_API_URL=\nCREDIT_AGRICOLE_CLIENT_ID=\nCREDIT_AGRICOLE_CLIENT_SECRET=\n\n# Performance Configuration\nWORKERS=1\nWORKER_CONNECTIONS=100\nWORKER_CLASS=uvicorn.workers.UvicornWorker\nKEEP_ALIVE=2\nMAX_REQUESTS=100\nMAX_REQUESTS_JITTER=10\nPRELOAD_APP=false\n\n# Health Check Configuration\nHEALTH_CHECK_ENABLED=true\nHEALTH_CHECK_PATH=/health\nHEALTH_CHECK_TIMEOUT=10\n\n# Feature Flags\nFEATURE_USER_REGISTRATION=true\nFEATURE_EMAIL_VERIFICATION=false\nFEATURE_PASSWORD_RESET=true\nFEATURE_MULTI_COMPANY=true\nFEATURE_ADVANCED_ANALYTICS=true\nFEATURE_AUDIT_LOG=true\nFEATURE_NOTIFICATIONS=true\nFEATURE_INTEGRATIONS=false\nFEATURE_ML_PREDICTIONS=true\nFEATURE_REAL_TIME_UPDATES=true\n\n# Development Tools\nDEV_MODE=true\nAUTO_RELOAD=true\nHOT_RELOAD=true\nDEBUG_TOOLBAR=true\nSQL_ECHO=false\nSEED_DATA=true\nMOCK_EXTERNAL_APIS=true\n\n# Testing Configuration\nTEST_MODE=false\nTEST_DATA_ENABLED=true\nTEST_EMAIL_BACKEND=console\nTEST_PAYMENT_GATEWAY=false\n\n# Next.js Configuration\nNEXT_PUBLIC_API_URL=http://localhost:8000\nNEXT_PUBLIC_ML_API_URL=http://localhost:8001\nNEXT_PUBLIC_ENVIRONMENT=development\nNEXT_TELEMETRY_DISABLED=1\n\n# Docker Development\nDOCKER_BUILDKIT=1\nCOMPOSE_DOCKER_CLI_BUILD=1"