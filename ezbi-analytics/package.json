{
  "name": "ezbi-analytics",
  "version": "1.0.0",
  "description": "EZBI Analytics - AI-Powered Cash Flow Prediction Platform for French Manufacturing SMEs",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "npm run build:frontend && npm run build:backend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && python -m pip install -e .",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test",
    "test:backend": "cd backend && pytest",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && ruff check .",
    "format": "npm run format:frontend && npm run format:backend",
    "format:frontend": "cd frontend && npm run format",
    "format:backend": "cd backend && ruff format .",
    "deploy": "npm run deploy:frontend && npm run deploy:backend",
    "deploy:frontend": "cd frontend && vercel --prod",
    "deploy:backend": "cd backend && railway up",
    "db:migrate": "cd backend && alembic upgrade head",
    "db:create-migration": "cd backend && alembic revision --autogenerate",
    "ml:train": "cd ml-pipeline && python train_models.py",
    "ml:predict": "cd ml-pipeline && python predict.py"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.45.0",
    "prettier": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/philbeliveau/learn-to-flow.git"
  },
  "keywords": [
    "cash-flow",
    "prediction",
    "ai",
    "manufacturing",
    "sme",
    "french",
    "nextjs",
    "fastapi",
    "postgresql",
    "ml"
  ],
  "author": "Philippe Beliveau",
  "license": "MIT",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/philbeliveau/learn-to-flow/issues"
  },
  "homepage": "https://github.com/philbeliveau/learn-to-flow#readme",
  "dependencies": {
    "dotenv": "^17.2.0"
  }
}
