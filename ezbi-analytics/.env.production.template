# Production Environment Configuration for EZBI Analytics Platform
# DevOps Engineer Implementation - SPARC Production Deployment

# ===========================================
# CRITICAL: COPY THIS FILE TO .env.production
# AND UPDATE ALL VALUES FOR YOUR ENVIRONMENT
# ===========================================

# Application Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info
CORS_ORIGINS=https://app.ezbi.fr,https://api.ezbi.fr

# Database Configuration
DATABASE_URL=postgresql://ezbi_user:CHANGE_ME@postgres:5432/ezbi_analytics
POSTGRES_DB=ezbi_analytics
POSTGRES_USER=ezbi_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# Redis Configuration
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# JWT Configuration
JWT_SECRET=CHANGE_ME_TO_STRONG_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_TIME=3600

# NextAuth Configuration
NEXTAUTH_URL=https://app.ezbi.fr
NEXTAUTH_SECRET=CHANGE_ME_TO_STRONG_SECRET_KEY_AT_LEAST_32_CHARS

# API URLs
NEXT_PUBLIC_API_URL=https://api.ezbi.fr
NEXT_PUBLIC_ML_API_URL=https://ml.ezbi.fr

# SSL Configuration
SSL_CERT_PATH=/app/ssl/cert.pem
SSL_KEY_PATH=/app/ssl/key.pem

# Monitoring Configuration
GRAFANA_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
PROMETHEUS_RETENTION_TIME=30d

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_ADDRESS=noreply@ezbi.fr

# Backup Configuration
BACKUP_ENCRYPTION_KEY=CHANGE_ME_TO_STRONG_ENCRYPTION_KEY_32_CHARS
S3_BACKUP_BUCKET=ezbi-analytics-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK

# Sentry Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Performance Configuration
WORKER_PROCESSES=4
MAX_CONNECTIONS=1000
WORKER_CONNECTIONS=1024

# ML Engine Configuration
ML_MODEL_PATH=/app/models
ML_CACHE_SIZE=1000
ML_BATCH_SIZE=32
TENSORFLOW_INTER_OP_PARALLELISM_THREADS=4
TENSORFLOW_INTRA_OP_PARALLELISM_THREADS=4

# File Upload Configuration
MAX_FILE_SIZE=100MB
UPLOAD_PATH=/app/uploads
ALLOWED_FILE_TYPES=csv,xlsx,json,pdf

# Rate Limiting Configuration
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_WINDOW=300
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# Security Configuration
CSRF_PROTECTION=true
SECURE_COOKIES=true
HSTS_MAX_AGE=31536000
CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' wss:; frame-ancestors 'none';

# Session Configuration
SESSION_TIMEOUT=3600
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=strict

# Logging Configuration
LOG_FILE_PATH=/app/logs/application.log
LOG_MAX_SIZE=100MB
LOG_MAX_FILES=10
LOG_ROTATE_DAYS=30

# Health Check Configuration
HEALTH_CHECK_INTERVAL=30
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_RETRIES=3

# Metrics Configuration
METRICS_ENABLED=true
METRICS_ENDPOINT=/metrics
PROMETHEUS_METRICS=true

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000
CACHE_COMPRESSION=true

# Search Configuration
SEARCH_INDEX_PATH=/app/search
SEARCH_MAX_RESULTS=100

# Notification Configuration
NOTIFICATION_RETENTION_DAYS=90
NOTIFICATION_BATCH_SIZE=100

# Audit Configuration
AUDIT_LOG_ENABLED=true
AUDIT_LOG_PATH=/app/logs/audit.log
AUDIT_RETENTION_DAYS=365

# Backup Schedule Configuration
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# API Configuration
API_VERSION=v1
API_RATE_LIMIT=1000
API_TIMEOUT=30
API_MAX_PAYLOAD_SIZE=10MB

# Database Pool Configuration
DB_POOL_SIZE=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis Pool Configuration
REDIS_POOL_SIZE=10
REDIS_POOL_TIMEOUT=30

# Feature Flags
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_ML_PREDICTIONS=true
FEATURE_REAL_TIME_UPDATES=true
FEATURE_EXPORT_FUNCTIONALITY=true
FEATURE_SLACK_INTEGRATION=true

# Maintenance Configuration
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="System maintenance in progress. Please try again later."

# Deployment Configuration
DEPLOYMENT_ENVIRONMENT=production
DEPLOYMENT_VERSION=1.0.0
DEPLOYMENT_TIMESTAMP=2024-01-01T00:00:00Z

# Container Configuration
CONTAINER_MEMORY_LIMIT=2G
CONTAINER_CPU_LIMIT=1.0
CONTAINER_RESTART_POLICY=unless-stopped

# Network Configuration
NETWORK_SUBNET=172.25.0.0/16
NETWORK_GATEWAY=172.25.0.1

# Volume Configuration
POSTGRES_DATA_PATH=/var/lib/postgresql/data
REDIS_DATA_PATH=/data
UPLOAD_DATA_PATH=/app/uploads
LOG_DATA_PATH=/app/logs

# ===========================================
# SECURITY REMINDER:
# - Change ALL default passwords
# - Use strong, unique secrets
# - Enable SSL/TLS in production
# - Regular security audits
# - Monitor for suspicious activity
# ===========================================