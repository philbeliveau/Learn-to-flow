{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "python app_flask.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "healthcheck": {
    "type": "http",
    "path": "/health",
    "port": 8003,
    "interval": 30,
    "timeout": 10,
    "maxRetries": 3
  },
  "environments": {
    "production": {
      "deploy": {
        "cronSchedule": "0 0 * * *"
      }
    }
  }
}