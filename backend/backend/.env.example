# Railway Environment Variables for Scheduler

# Enable/disable scheduler (set to false for development if you don't want jobs running)
ENABLE_SCHEDULER=true

# Railway environment
RAILWAY_ENVIRONMENT=production

# Timezone for scheduled jobs (default UTC)
TZ=UTC

# Database path
DATABASE_PATH=data/ezbi_analytics.db

# Scheduler log level
SCHEDULER_LOG_LEVEL=INFO

# Data retention settings (days)
TRANSACTION_RETENTION_DAYS=365
INVOICE_RETENTION_DAYS=730
PREDICTION_RETENTION_DAYS=180

# Job execution limits
MAX_DAILY_TRANSACTIONS_PER_COMPANY=20
MAX_DAILY_INVOICES=30
MAX_DAILY_PURCHASES=15
MAX_DAILY_PRODUCTION_ORDERS=10

# Flask settings
FLASK_ENV=production
FLASK_DEBUG=false